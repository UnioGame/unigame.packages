	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=C26C6B2902EF5C41868A56143497B6D9/Text/@EntryValue">namespace UniGame.Ecs.Proto.Characteristics.$CLASS$
{
    using System;
    using Base;
    using Base.Aspects;
    using Base.Components;
    using Cysharp.Threading.Tasks;
    using Feature;
    using LeoEcs.Bootstrap.Runtime.Attributes;
    using Leopotam.EcsProto;
    using Leopotam.EcsProto.QoL;
    using UniGame.LeoEcs.Shared.Extensions;
    using UnityEngine;
    
#if ENABLE_IL2CPP
    using Unity.IL2CPP.CompilerServices;
#endif
    
    /// &lt;summary&gt;
    /// new characteristic feature: $CLASS$ 
    /// &lt;/summary&gt;
#if ENABLE_IL2CPP
    [Il2CppSetOption(Option.NullChecks, false)]
    [Il2CppSetOption(Option.ArrayBoundsChecks, false)]
    [Il2CppSetOption(Option.DivideByZeroChecks, false)]
#endif
    [Serializable]
    [CreateAssetMenu(menuName = "Proto Features/Characteristics/$CLASS$")]
    public sealed class $CLASS$Feature : CharacteristicFeature&lt;$CLASS$EcsFeature&gt;
    {
        
    }
    
    /// &lt;summary&gt;
    /// new characteristic feature: $CLASS$ 
    /// &lt;/summary&gt;
#if ENABLE_IL2CPP
    [Il2CppSetOption(Option.NullChecks, false)]
    [Il2CppSetOption(Option.ArrayBoundsChecks, false)]
    [Il2CppSetOption(Option.DivideByZeroChecks, false)]
#endif
    [Serializable]
    public sealed class $CLASS$EcsFeature : CharacteristicEcsFeature
    {
        protected override  UniTask OnInitializeAsync(IProtoSystems ecsSystems)
        {
            //register $CLASS$ characteristic
            ecsSystems.AddCharacteristic&lt;$CLASS$Component&gt;();
            //update $CLASS$ by request
            ecsSystems.Add(new Process$CLASS$ChangedSystem());
            
            return UniTask.CompletedTask;
        }
    }
    
    /// &lt;summary&gt;
    /// characteristic $CLASS$ aspect data
    /// &lt;/summary&gt;
#if ENABLE_IL2CPP
    [Il2CppSetOption(Option.NullChecks, false)]
    [Il2CppSetOption(Option.ArrayBoundsChecks, false)]
    [Il2CppSetOption(Option.DivideByZeroChecks, false)]
#endif
    [Serializable]
    public class $CLASS$Aspect : GameCharacteristicAspect&lt;$CLASS$Component&gt;
    {
        
    }
    
    /// &lt;summary&gt;
    /// $CLASS$ characteristic component
    /// &lt;/summary&gt;
    [Serializable]
#if ENABLE_IL2CPP
    [Il2CppSetOption(Option.NullChecks, false)]
    [Il2CppSetOption(Option.ArrayBoundsChecks, false)]
    [Il2CppSetOption(Option.DivideByZeroChecks, false)]
#endif
    public struct $CLASS$Component
    {
        /// &lt;summary&gt;
        /// Current value of characteristic.
        /// &lt;/summary&gt;
        public float Value;
        
        /// &lt;summary&gt;
        /// Max value of characteristic.
        /// &lt;/summary&gt;
        public float MaxValue;

        /// &lt;summary&gt;
        /// Min value of characteristic.
        /// &lt;/summary&gt;
        public float MinValue;
        
        /// &lt;summary&gt;
        /// Base value of characteristic.
        /// &lt;/summary&gt;
        public float BaseValue;
    }
    
#if ENABLE_IL2CPP
    [Il2CppSetOption(Option.NullChecks, false)]
    [Il2CppSetOption(Option.ArrayBoundsChecks, false)]
    [Il2CppSetOption(Option.DivideByZeroChecks, false)]
#endif
    [Serializable]
    [ECSDI]
    public sealed class Process$CLASS$ChangedSystem : IProtoRunSystem
    {
        private $CLASS$Aspect _$CLASS$Aspect;
        
        private ProtoIt _filter = It
            .Chain&lt;CharacteristicChangedComponent&lt;$CLASS$Component&gt;&gt;()
            .Inc&lt;CharacteristicComponent&lt;$CLASS$Component&gt;&gt;()
            .Inc&lt;$CLASS$Component&gt;()
            .End();
        
        private ProtoWorld _world;
        
        public void Run()
        {
            foreach (var entity in _filter)
            {
                ref var characteristicComponent = ref _$CLASS$Aspect.Value.Get(entity);
                ref var $CLASS$Component = ref _$CLASS$Aspect.Characteristic.Get(entity);
                $CLASS$Component.Value = characteristicComponent.Value;
                $CLASS$Component.MaxValue = characteristicComponent.MaxValue;
                $CLASS$Component.MinValue = characteristicComponent.MinValue;
                $CLASS$Component.BaseValue = characteristicComponent.BaseValue;
            }
        }
    }
    
#if ENABLE_IL2CPP
    [Il2CppSetOption(Option.NullChecks, false)]
    [Il2CppSetOption(Option.ArrayBoundsChecks, false)]
    [Il2CppSetOption(Option.DivideByZeroChecks, false)]
#endif
    [Serializable]
    public class $CLASS$ComponentConverter : GameCharacteristicConverter&lt;$CLASS$Component&gt;
    {

    }
}</s:String>
